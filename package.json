{
  "name": "aqa_course_playwright",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "npx tsc",
    "start": "node ./dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --config .prettierrc src/**/*.ts --check src/",
    "prettier:fix": "prettier --config .prettierrc src/**/*.ts --write src/",
    "test": "npx playwright test",
    "test:ui:regression": "npx playwright test --project=sales-portal-ui --grep @regression|@smoke",
    "test:ui:smoke": "npm run test -- --project=sales-portal-ui --grep @smoke",
    "ui-mode": "npx playwright test --ui",
    "html-report-open": "npx playwright show-report",
    "allure-report": "allure generate allure-results -o allure-report --clean",
    "allure-report-open": "npm run allure-report && allure open allure-report",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "codegen": "npx playwright codegen",
    "test:report": "npx playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aharashchuk/aqa_course_playwright.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/aharashchuk/aqa_course_playwright/issues"
  },
  "homepage": "https://github.com/aharashchuk/aqa_course_playwright#readme",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.56.0",
    "@types/bson": "^4.0.5",
    "@types/dotenv": "^6.1.1",
    "@types/lodash": "^4.17.20",
    "@types/moment": "^2.11.29",
    "@types/node": "^24.7.0",
    "@types/numeral": "^2.0.5",
    "allure-playwright": "^3.4.2",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "jiti": "^2.6.1",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "dependencies": {
    "@faker-js/faker": "^10.1.0",
    "allure-commandline": "^2.34.1",
    "bson": "^7.0.0",
    "dotenv": "^17.2.3",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "numeral": "^2.0.6"
  }
}
